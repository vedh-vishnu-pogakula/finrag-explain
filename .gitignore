__pycache__/
*.pyc
.venv/
venv/
.env

# raw + processed data are large / regeneratable -- don't commit them
data/raw/
data/processed/
!data/sample/

# eval outputs. The summary reports ARE results -- the ablation table and the B1 numbers are
# cited in README.md and will be cited in the paper, so they are versioned (~100KB total).
# The per-question checkpoints are ~5MB, regenerable, and change on every partial run, so
# they stay out; copy them out of Drive by hand when a failure analysis needs them.
eval/results/checkpoints/
# Match both separators: tags are passed on the command line and have arrived as both
# `_SMOKE` and `_COLAB-SMOKE`. A single-separator pattern silently let the second through.
eval/results/*SMOKE*
eval/results/*VERIFY*
eval/results/*SPOT*
# Offline stand-ins (StubGenerator, HashEmbedder, StubEntailmentScorer) exist to prove the
# plumbing without a model. Their scores are meaningless by construction, so they must never
# sit next to real results in the repo.
eval/results/*STUBGEN*
eval/results/*HASHEMB*
eval/results/*STUBNLI*

.pytest_cache/
.DS_Store
*.faiss
*.index
# Seed-sweep perturbation outputs: ~120KB each and regenerable; only the summary
# (perturbation_variance.json) is cited.
eval/results/*_SEED*
